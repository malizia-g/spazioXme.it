{# Icone lineari minimali, decorative (aria-hidden). Uso: {{ icona("respiro") }} #}
{% macro icona(nome) %}
  {% if nome == "respiro" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="10"/>
      <path d="M24 4v6M24 38v6M4 24h6M38 24h6"/>
    </svg>
  {% elif nome == "meditazione" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="14" r="6"/>
      <path d="M10 38c0-8 6-14 14-14s14 6 14 14"/>
    </svg>
  {% elif nome == "movimento" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="9" r="5"/>
      <path d="M24 14v14M24 20l-10 6M24 20l10 6M24 28l-8 12M24 28l8 12"/>
    </svg>
  {% elif nome == "energia" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <path d="M26 4 12 26h10l-2 18 16-24H26z" stroke-linejoin="round"/>
    </svg>
  {% elif nome == "ascolto" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <path d="M8 26v-4a16 16 0 0 1 32 0v4"/>
      <path d="M8 26a4 4 0 0 1 8 0v6a4 4 0 0 1-8 0zM32 26a4 4 0 0 1 8 0v6a4 4 0 0 1-8 0z"/>
    </svg>
  {% elif nome == "gruppo" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="17" cy="20" r="7"/>
      <circle cx="31" cy="20" r="7"/>
      <path d="M8 40c1-6 5-10 9-10s8 4 9 10M22 40c1-6 5-10 9-10s8 4 9 10"/>
    </svg>
  {% elif nome == "accoglienza" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <path d="M8 24 24 10l16 14" stroke-linejoin="round"/>
      <path d="M12 22v14h8v-8h8v8h8V22" stroke-linejoin="round"/>
    </svg>
  {% elif nome == "corpo-presenza" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="10" r="5"/>
      <path d="M24 15v13M14 22h20M17 40l7-12 7 12"/>
    </svg>
  {% elif nome == "comunita" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="6"/>
      <circle cx="10" cy="14" r="4"/>
      <circle cx="38" cy="14" r="4"/>
      <circle cx="10" cy="34" r="4"/>
      <circle cx="38" cy="34" r="4"/>
    </svg>
  {% elif nome == "autenticita" %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="16"/>
      <path d="M24 16v16M17 22l14 4M31 22l-14 4"/>
    </svg>
  {% else %}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="16"/>
    </svg>
  {% endif %}
{% endmacro %}
